ВЫБРАТЬ
	ИнвентаризацияТовары.Ссылка КАК СсылкаИнвентаризации,
	ИнвентаризацияТовары.Ссылка.Номер КАК НомерИнвентаризации,
	ИнвентаризацияТовары.Ссылка.Дата КАК ДатаИнвентаризации,

	ВЫБОР
		КОГДА ИнвентаризацияТовары.Ссылка.СкладВТабличнойЧасти
			ТОГДА ИнвентаризацияТовары.Склад
		ИНАЧЕ ИнвентаризацияТовары.Ссылка.Склад
	КОНЕЦ КАК Склад,

	ВЫБОР
		КОГДА ИнвентаризацияТовары.Ссылка.СкладВТабличнойЧасти
			ТОГДА ИнвентаризацияТовары.Склад.Владелец
		ИНАЧЕ ИнвентаризацияТовары.Ссылка.Склад.Владелец
	КОНЕЦ КАК РЦ,

	ИнвентаризацияТовары.НомерСтроки КАК НомерСтроки,

	ИнвентаризацияТовары.Номенклатура.Код КАК КодНоменклатуры,
	ИнвентаризацияТовары.Номенклатура КАК Номенклатура,

	ИнвентаризацияТовары.Характеристика.Код КАК КодХарактеристики,
	ИнвентаризацияТовары.Характеристика КАК Характеристика,

	ИнвентаризацияТовары.Номенклатура.ЕдиницаХраненияОстатков
		КАК ЕдиницаИзмерения,

	ИнвентаризацияТовары.Количество КАК ФактическоеКоличество,
	ИнвентаризацияТовары.КоличествоУчет КАК УчетноеКоличество,
	ИнвентаризацияТовары.Расхождение КАК Расхождение

ПОМЕСТИТЬ ВТ_Инвентаризации

ИЗ
	Документ.ИнвентаризацияСклад.Товары КАК ИнвентаризацияТовары

ГДЕ
	ИнвентаризацияТовары.Ссылка.Дата >= &ДатаНачала
	И ИнвентаризацияТовары.Ссылка.Дата < &ДатаОкончания

	И НЕ ИнвентаризацияТовары.Ссылка.ПометкаУдаления
	И ИнвентаризацияТовары.Ссылка.Проведен

	И ВЫБОР
		КОГДА ИнвентаризацияТовары.Ссылка.СкладВТабличнойЧасти
			ТОГДА ИнвентаризацияТовары.Склад
		ИНАЧЕ ИнвентаризацияТовары.Ссылка.Склад
	КОНЕЦ В (&Склады)
;

////////////////////////////////////////////////////////////////////////////////

ВЫБРАТЬ
	КоличествоВКоробке.Номенклатура КАК Номенклатура,
	КоличествоВКоробке.Характеристика КАК Характеристика,

	МАКСИМУМ(
		КоличествоВКоробке.Количество
	) КАК КоличествоВКоробке

ПОМЕСТИТЬ ВТ_КоличествоВКоробке

ИЗ
	РегистрСведений.КоличествоВКоробке.СрезПоследних(
			&ДатаОкончания,
			) КАК КоличествоВКоробке

ГДЕ
	(
		КоличествоВКоробке.Номенклатура,
		КоличествоВКоробке.Характеристика
	) В
		(ВЫБРАТЬ
			ВТ_Инвентаризации.Номенклатура,
			ВТ_Инвентаризации.Характеристика
		ИЗ
			ВТ_Инвентаризации КАК ВТ_Инвентаризации)

СГРУППИРОВАТЬ ПО
	КоличествоВКоробке.Номенклатура,
	КоличествоВКоробке.Характеристика
;

////////////////////////////////////////////////////////////////////////////////

ВЫБРАТЬ
	ВТ_Инвентаризации.СсылкаИнвентаризации
		КАК СсылкаИнвентаризации,

	ВТ_Инвентаризации.НомерИнвентаризации
		КАК НомерИнвентаризации,

	ВТ_Инвентаризации.ДатаИнвентаризации
		КАК ДатаИнвентаризации,

	ВТ_Инвентаризации.Склад КАК Склад,
	ВТ_Инвентаризации.РЦ КАК РЦ,
	ВТ_Инвентаризации.НомерСтроки КАК НомерСтроки,

	ВТ_Инвентаризации.КодНоменклатуры КАК КодНоменклатуры,
	ВТ_Инвентаризации.Номенклатура КАК Номенклатура,

	ВТ_Инвентаризации.КодХарактеристики КАК КодХарактеристики,
	ВТ_Инвентаризации.Характеристика КАК Характеристика,

	ВТ_Инвентаризации.ЕдиницаИзмерения КАК ЕдиницаИзмерения,

	ВТ_Инвентаризации.ФактическоеКоличество
		КАК ФактическоеКоличество,

	ВТ_Инвентаризации.УчетноеКоличество
		КАК УчетноеКоличество,

	ВТ_Инвентаризации.Расхождение КАК Расхождение,

	ЕСТЬNULL(
		ВТ_КоличествоВКоробке.КоличествоВКоробке,
		0
	) КАК КоличествоВКоробке,

	ВЫБОР
		КОГДА ЕСТЬNULL(
			ВТ_КоличествоВКоробке.КоличествоВКоробке,
			0
		) = 0
			ТОГДА 0

		КОГДА ЕСТЬNULL(
			ВТ_Инвентаризации.ФактическоеКоличество,
			0
		) <= 0
			ТОГДА 0

		ИНАЧЕ
			ЦЕЛ(
				ВТ_Инвентаризации.ФактическоеКоличество
				/ ВТ_КоличествоВКоробке.КоличествоВКоробке
			)

			+ ВЫБОР
				КОГДА
					(
						ВТ_Инвентаризации.ФактическоеКоличество
						- ЦЕЛ(
							ВТ_Инвентаризации.ФактическоеКоличество
							/ ВТ_КоличествоВКоробке.КоличествоВКоробке
						)
						* ВТ_КоличествоВКоробке.КоличествоВКоробке
					)
					/ ВТ_КоличествоВКоробке.КоличествоВКоробке >= 0.5

					ТОГДА 1
				ИНАЧЕ 0
			КОНЕЦ
	КОНЕЦ КАК РасчетноеКоличествоКоробов,

	ВЫБОР
		КОГДА ЕСТЬNULL(
			ВТ_КоличествоВКоробке.КоличествоВКоробке,
			0
		) = 0
			ТОГДА "Количество в коробке не найдено"

		КОГДА ЕСТЬNULL(
			ВТ_Инвентаризации.ФактическоеКоличество,
			0
		) <= 0
			ТОГДА "Фактический остаток не положительный"

		ИНАЧЕ "Расчет выполнен"
	КОНЕЦ КАК КонтрольРасчета

ИЗ
	ВТ_Инвентаризации КАК ВТ_Инвентаризации

		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоВКоробке
			КАК ВТ_КоличествоВКоробке

		ПО ВТ_Инвентаризации.Номенклатура =
			ВТ_КоличествоВКоробке.Номенклатура

			И ВТ_Инвентаризации.Характеристика =
				ВТ_КоличествоВКоробке.Характеристика

УПОРЯДОЧИТЬ ПО
	ВТ_Инвентаризации.ДатаИнвентаризации,
	ВТ_Инвентаризации.НомерИнвентаризации,
	ВТ_Инвентаризации.НомерСтроки
