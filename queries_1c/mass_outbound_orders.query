ВЫБРАТЬ
	Товары.Ссылка КАК СсылкаРО,
	Товары.Ссылка.Номер КАК НомерРО,
	Товары.Ссылка.Дата КАК ДатаРО,
	Товары.Ссылка.Склад КАК Склад,
	Товары.Ссылка.Склад.Владелец КАК РЦ,

	Товары.НомерСтроки КАК НомерСтроки,

	Товары.Номенклатура.Код КАК КодНоменклатуры,
	Товары.Номенклатура КАК Номенклатура,

	Товары.Характеристика.Код КАК КодХарактеристики,
	Товары.Характеристика КАК Характеристика,

	Товары.ДатаПроизводства КАК ДатаПроизводства,
	Товары.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	Товары.Количество КАК Количество

ПОМЕСТИТЬ ВТ_ТоварыРО

ИЗ
	Документ.РасходныйОрдерСклад.Товары КАК Товары

ГДЕ
	Товары.Ссылка.Дата >= &ДатаНачала
	И Товары.Ссылка.Дата < &ДатаОкончания
	И Товары.Ссылка.Склад В (&Склады)
	И Товары.Ссылка.ПометкаУдаления = ЛОЖЬ
	И Товары.Ссылка.Проведен = ИСТИНА
;

////////////////////////////////////////////////////////////////////////////////

ВЫБРАТЬ
	ВТ_ТоварыРО.СсылкаРО КАК СсылкаРО,
	ВТ_ТоварыРО.НомерРО КАК НомерРО,
	ВТ_ТоварыРО.ДатаРО КАК ДатаРО,
	ВТ_ТоварыРО.Склад КАК Склад,
	ВТ_ТоварыРО.РЦ КАК РЦ,

	ВТ_ТоварыРО.НомерСтроки КАК НомерСтроки,

	ВТ_ТоварыРО.КодНоменклатуры КАК КодНоменклатуры,
	ВТ_ТоварыРО.Номенклатура КАК Номенклатура,

	ВТ_ТоварыРО.КодХарактеристики КАК КодХарактеристики,
	ВТ_ТоварыРО.Характеристика КАК Характеристика,

	ВТ_ТоварыРО.ДатаПроизводства КАК ДатаПроизводства,
	ВТ_ТоварыРО.ЕдиницаИзмерения КАК ЕдиницаИзмерения,

	МАКСИМУМ(ВТ_ТоварыРО.Количество) КАК Количество,

	ЕСТЬNULL(
		МАКСИМУМ(
			КоличествоВКоробкеПоДатамПроизводства.Количество
		),
		0
	) КАК КоличествоВКоробке

ПОМЕСТИТЬ ВТ_РасчетКоробов

ИЗ
	ВТ_ТоварыРО КАК ВТ_ТоварыРО

		ЛЕВОЕ СОЕДИНЕНИЕ
			РегистрСведений.КоличествоВКоробкеПоДатамПроизводства
			КАК КоличествоВКоробкеПоДатамПроизводства

		ПО ВТ_ТоварыРО.Номенклатура =
			КоличествоВКоробкеПоДатамПроизводства.Номенклатура

			И ВТ_ТоварыРО.Характеристика =
				КоличествоВКоробкеПоДатамПроизводства.Характеристика

			И ВТ_ТоварыРО.ДатаПроизводства =
				КоличествоВКоробкеПоДатамПроизводства.ДатаПроизводства

			И ВТ_ТоварыРО.РЦ =
				КоличествоВКоробкеПоДатамПроизводства.РЦ

СГРУППИРОВАТЬ ПО
	ВТ_ТоварыРО.СсылкаРО,
	ВТ_ТоварыРО.НомерРО,
	ВТ_ТоварыРО.ДатаРО,
	ВТ_ТоварыРО.Склад,
	ВТ_ТоварыРО.РЦ,
	ВТ_ТоварыРО.НомерСтроки,
	ВТ_ТоварыРО.КодНоменклатуры,
	ВТ_ТоварыРО.Номенклатура,
	ВТ_ТоварыРО.КодХарактеристики,
	ВТ_ТоварыРО.Характеристика,
	ВТ_ТоварыРО.ДатаПроизводства,
	ВТ_ТоварыРО.ЕдиницаИзмерения
;

////////////////////////////////////////////////////////////////////////////////

ВЫБРАТЬ
	ВТ_РасчетКоробов.СсылкаРО КАК СсылкаРО,
	ВТ_РасчетКоробов.НомерРО КАК НомерРО,
	ВТ_РасчетКоробов.ДатаРО КАК ДатаРО,
	ВТ_РасчетКоробов.Склад КАК Склад,
	ВТ_РасчетКоробов.РЦ КАК РЦ,

	ВТ_РасчетКоробов.НомерСтроки КАК НомерСтроки,

	ВТ_РасчетКоробов.КодНоменклатуры КАК КодНоменклатуры,
	ВТ_РасчетКоробов.Номенклатура КАК Номенклатура,

	ВТ_РасчетКоробов.КодХарактеристики КАК КодХарактеристики,
	ВТ_РасчетКоробов.Характеристика КАК Характеристика,

	ВТ_РасчетКоробов.ДатаПроизводства КАК ДатаПроизводства,
	ВТ_РасчетКоробов.ЕдиницаИзмерения КАК ЕдиницаИзмерения,

	ВТ_РасчетКоробов.Количество КАК Количество,
	ВТ_РасчетКоробов.КоличествоВКоробке КАК КоличествоВКоробке,

	ВЫБОР
		КОГДА ВТ_РасчетКоробов.КоличествоВКоробке = 0
			ТОГДА 0

		ИНАЧЕ
			ЦЕЛ(
				ВТ_РасчетКоробов.Количество
				/ ВТ_РасчетКоробов.КоличествоВКоробке
			)

			+ ВЫБОР
				КОГДА
					(
						ВТ_РасчетКоробов.Количество
						- ЦЕЛ(
							ВТ_РасчетКоробов.Количество
							/ ВТ_РасчетКоробов.КоличествоВКоробке
						)
						* ВТ_РасчетКоробов.КоличествоВКоробке
					)
					/ ВТ_РасчетКоробов.КоличествоВКоробке >= 0.5

					ТОГДА 1
				ИНАЧЕ 0
			КОНЕЦ
	КОНЕЦ КАК РасчетноеОтгруженоКоробок,

	ВЫБОР
		КОГДА ВТ_РасчетКоробов.КоличествоВКоробке = 0
			ТОГДА "Количество в коробке не найдено"
		ИНАЧЕ "Расчет выполнен"
	КОНЕЦ КАК КонтрольРасчета

ИЗ
	ВТ_РасчетКоробов КАК ВТ_РасчетКоробов

УПОРЯДОЧИТЬ ПО
	ВТ_РасчетКоробов.ДатаРО,
	ВТ_РасчетКоробов.НомерРО,
	ВТ_РасчетКоробов.НомерСтроки
